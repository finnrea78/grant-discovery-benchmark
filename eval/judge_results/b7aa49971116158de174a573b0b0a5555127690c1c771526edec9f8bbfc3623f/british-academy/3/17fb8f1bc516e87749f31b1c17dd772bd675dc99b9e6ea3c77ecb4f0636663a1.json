          "outcome": "ok",
          "record_supported": true,
          "justification": "All claims made in the agent's text are directly supported by the provided page text.",
          "claims": [
            {
              "text": "The British Academy Postdoctoral Fellowships is a three-year award.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "The award is made to an annual cohort of outstanding early-career researchers.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "The fellowships are for researchers in the humanities or social sciences.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "The scheme opens for applications on July 1, 2026.",
              "claim_type": "deadline",
              "supported": true
            },
            {
              "text": "The deadline for submissions is September 30, 2026, at 17:00 BST.",
              "claim_type": "deadline",
              "supported": true
            },
            {
              "text": "The earliest start date for the fellowship is September 1, 2027.",
              "claim_type": "other",
              "supported": true
            },
            {
              "text": "The fellowship is funded by the Department for Science, Innovation & Technology (DSIT).",
              "claim_type": "other",
              "supported": true
            },
            {
              "text": "Applicants must be from the humanities and social sciences.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must be based at an eligible university or research organisation in the UK for the duration of the Fellowship.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "British citizens and any nationals from the EEA are eligible.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Anyone of any nationality who has a doctorate from a UK university is eligible.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants who do not meet the prior categories may be accepted if they can demonstrate \u2018strong prior association\u2019 with the UK academic community.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Eligible applicants are expected to be at an early stage of their career.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants are expected to have completed their Viva Voce examination between April 1, 2024, and April 1, 2027.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must already be of postdoctoral status at the time when the Research Awards Committee meets.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants who have been appointed to a permanent academic post in an institution of higher education at any time in their career are not eligible.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Exemption requests for the permanent academic post criterion must be approved by The British Academy team prior to application submission.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "The Fellowship is tenable for three years.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "The Fellowship starts from Autumn 2027.",
              "claim_type": "other",
              "supported": true
            },
            {
              "text": "The Fellowship is tenable in a UK-based university or higher education institution.",
              "claim_type": "other",
              "supported": true
            },
            {
              "text": "Applicants must be supported by one self-nominated referee.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "The referee will be asked to fill in a questionnaire via Flexi-Grant\u00ae.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "The referee should normally be the external examiner or someone external to the applicant.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "The referee may not be the applicant's proposed mentor, doctoral supervisor, an internal examiner, or someone based at the same institution as the proposed host organisation.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applications must be submitted online using the British Academy's Grant Management System (GMS), Flexi-Grant\u00ae.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "The deadline for UK institutional approval is Wednesday 30 September 2026 (17:00 BST).",
              "claim_type": "deadline",
              "supported": true
            }
          ],
          "error": null
        }
