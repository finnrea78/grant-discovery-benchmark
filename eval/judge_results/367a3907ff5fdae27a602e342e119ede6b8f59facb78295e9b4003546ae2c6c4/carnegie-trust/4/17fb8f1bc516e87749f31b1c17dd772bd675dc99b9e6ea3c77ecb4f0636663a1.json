              "claim_type": "eligibility",
              "supported": false
            },
            {
              "text": "Applicants must have attended a secondary school or college in Scotland for at least two full years or have a substantial and recent connection to Scotland.",
              "claim_type": "eligibility",
              "supported": false
            },
            {
              "text": "Household income thresholds apply, banded by number of dependants.",
              "claim_type": "eligibility",
              "supported": false
            },
            {
              "text": "Most recipients previously withdrew from study.",
              "claim_type": "eligibility",
              "supported": false
            },
