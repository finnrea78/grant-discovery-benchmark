          "claims": [
            {
              "text": "The opportunity is open to students from low-income Scottish households.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must be enrolled on or have an unconditional offer for an undergraduate degree course.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "The undergraduate degree course must be at an eligible Scottish Higher Education Institution.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must be ineligible for tuition fee support from the Scottish Government.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must be ordinarily resident in Scotland.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must be entitled to remain indefinitely in the UK, hold a qualifying visa valid for the entire course duration, or be an asylum seeker.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must not already have a university degree, with an exception for the second-degree scheme.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants must not be eligible for public funds toward tuition fees.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Income thresholds apply for eligibility.",
              "claim_type": "eligibility",
              "supported": true
            }
