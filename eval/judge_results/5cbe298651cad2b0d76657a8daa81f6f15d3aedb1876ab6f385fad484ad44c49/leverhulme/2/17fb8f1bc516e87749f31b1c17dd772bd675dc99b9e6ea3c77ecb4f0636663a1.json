          "justification": "All claims made in the agent's text are directly supported by the provided page text.",
          "claims": [
            {
              "text": "The funding is for well-established, distinguished researchers in the humanities and social sciences.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "The purpose of the funding is to complete a piece of original research.",
              "claim_type": "purpose",
              "supported": true
            },
            {
              "text": "Fellowships are particularly aimed at those who have been prevented by routine duties from completing original research.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "The fellowships fund replacement salary costs for the duration of the fellowship.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "The duration of a fellowship is for two or three years.",
              "claim_type": "other",
              "supported": true
            },
            {
              "text": "Applicants must be employed at an eligible UK university.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants should be able to demonstrate scholarship at the highest level.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Applicants need not already be of professorial standing.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Candidates should state explicitly what the proposed outcomes of their research will be.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "Previous holders of a Major Research Fellowship are not eligible to apply.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Fellowships fund the salary costs of an individual to undertake the normal duties of the applicant.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "A Major Research Fellow may also request research expenses up to an annual maximum of \u00a36,000.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "Research expenses must be requested as part of the application procedure.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "Applications must not include any ineligible costs.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "To make an application, access the Leverhulme Trust Grants Management System.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "Google Chrome is the recommended browser for the application.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "Refer to the Application Help Notes when completing the online application form.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "Applicants will be required to select three referees.",
              "claim_type": "process",
              "supported": true
            },
            {
              "text": "Referees must be able to comment on the applicant's research record and standing and the merit of the proposed research project.",
