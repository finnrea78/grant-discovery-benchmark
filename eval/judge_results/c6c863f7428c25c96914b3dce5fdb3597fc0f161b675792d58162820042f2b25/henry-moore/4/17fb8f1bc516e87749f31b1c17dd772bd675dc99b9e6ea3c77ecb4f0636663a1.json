            },
            {
              "text": "Autumn submissions close on 1 September.",
              "claim_type": "deadline",
              "supported": true
            },
            {
              "text": "Winter applications open on 1 November and close on 1 December.",
              "claim_type": "deadline",
              "supported": true
            },
            {
              "text": "Spring applications open on 1 February 2027 and close on 1 March 2027.",
              "claim_type": "deadline",
              "supported": true
            },
            {
