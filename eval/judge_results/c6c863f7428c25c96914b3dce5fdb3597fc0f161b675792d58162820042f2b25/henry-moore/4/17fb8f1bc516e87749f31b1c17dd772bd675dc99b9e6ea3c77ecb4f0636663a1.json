            {
              "text": "Henry Moore Grants fund research that expands the appreciation of sculpture.",
              "claim_type": "purpose",
              "supported": true
            },
            {
              "text": "UK and international non-profit organisations are eligible to apply for exhibitions, exhibition catalogues, commissions, conferences, research, non-commercial publications and the development of collections through acquisitions, conservation, cataloguing and display.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Individual sculpture historians, academics and conservators can apply to the Research and Travel category.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Individuals independently wishing to create, inform, develop or research their own practice are not eligible.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "Community project applications will only be considered when the applicant is a non-profit arts organisation.",
              "claim_type": "eligibility",
              "supported": true
            },
            {
              "text": "The maximum grant available for New Projects and Commissions is \u00a320,000.",
              "claim_type": "amount",
