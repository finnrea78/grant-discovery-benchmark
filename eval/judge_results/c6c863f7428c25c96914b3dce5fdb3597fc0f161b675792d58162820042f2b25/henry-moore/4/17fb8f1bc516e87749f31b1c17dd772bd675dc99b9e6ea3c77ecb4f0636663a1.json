            },
            {
              "text": "The maximum grant awarded for Conferences, Lectures and Publications is \u00a35,000.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "The maximum grant available for Long-Term Research grants is \u00a320,000.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "The maximum grant available for Research and Travel grants is \u00a32,500.",
              "claim_type": "amount",
              "supported": true
            },
            {
              "text": "Applications are considered four times per year.",
              "claim_type": "deadline",
