# Copy to .env and fill in. Only the API key is needed, and only for steps that
# call a model (skeleton, grid_run, judge). Leave the others empty to use the defaults.

# OpenRouter API key. Required for any live model call.
OPENROUTER_API_KEY=

# Timeout for one model request, in seconds. Default 180.
OPENROUTER_TIMEOUT_S=
# Retries on a transient API error. Default 3.
OPENROUTER_MAX_RETRIES=
# Base delay for exponential backoff between retries, in seconds. Default 2.
OPENROUTER_RETRY_BASE_S=

# Console log level for grid_run: DEBUG, INFO, WARNING or ERROR. Default INFO.
GRANT_EVAL_LOG_LEVEL=

# The settings below only affect the single test run (`uv run skeleton`).
# Model to run. Default openrouter/anthropic/claude-haiku-4.5.
SKELETON_MODEL=
# Start URL for the agent. Default https://www.leverhulme.ac.uk/
SKELETON_ENTRY_URL=
# Agent config name from config.AGENT_CONFIGS. Default standard.
SKELETON_AGENT_CONFIG=
# Max output tokens per request. Default 4000.
SKELETON_MAX_TOKENS=
# Set to 1 to use the offline mock backend and make no API call. Default off.
SKELETON_FORCE_MOCK=
# Set to 1 to fail instead of falling back to the mock when the live run fails. Default off.
SKELETON_NO_FALLBACK=
